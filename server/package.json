{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "server",
  "private": true,
  "version": "3.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --watch --env-file=.env index.js",
    "start": "cross-env NODE_ENV=production node --env-file=.env index.js --optimize_for_size",
    "register:commands": "node --env-file=.env startup/registerCommands.js",
    "unregister:commands": "node --env-file=.env startup/unregisterCommands.js",
    "lint": "oxlint"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/discordplace/discord.place/tree/main/apps/server"
  },
  "bugs": {
    "url": "https://github.com/discordplace/discord.place/issues"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@sentry/node": "^11.10.0",
    "ansi-colors": "^4.1.3",
    "archiver": "^8.0.0",
    "async-lock": "^1.4.1",
    "axios": "^1.21.0",
    "axios-retry": "^4.5.0",
    "body-parser": "^2.4.0",
    "chrono-node": "^2.10.3",
    "colord": "^2.10.0",
    "colorette": "^2.0.20",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "dedent": "^1.7.2",
    "discord.js": "^14.28.0",
    "express": "^5.3.0",
    "express-file-routing": "^3.1.0",
    "express-rate-limit": "^8.7.2",
    "express-validator": "^7.3.2",
    "fast-average-color-node": "^4.0.0",
    "helmet": "^8.3.0",
    "https-proxy-agent": "^9.1.0",
    "i18next": "^26.5.12",
    "i18next-intervalplural-postprocessor": "^3.0.0",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "lodash.shuffle": "^4.2.0",
    "module-alias": "^2.3.4",
    "moment": "^2.31.0",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "ms": "^2.1.3",
    "multer": "^2.5.0",
    "node-emoji": "^2.2.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xml": "^1.0.1"
  },
  "_moduleAliases": {
    "@": "./",
    "@/utils": "./src/utils",
    "@/schemas": "./src/schemas",
    "@/validations": "./src/utils/validations"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "cross-env": "^10.1.0",
    "eslint-plugin-ban": "^2.0.0",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sort-imports-requires": "^2.1.0",
    "oxlint": "1.90.0"
  }
}
